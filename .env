# Android emulator can't reach the host's "localhost" — 10.0.2.2 is the special
# alias Android uses to reach 127.0.0.1 on the machine running Metro/FastAPI.
# iOS simulator: use http://127.0.0.1:8000 instead.
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.23:8000.
# Production: swap this for your deployed FastAPI URL.
API_BASE_URL=https://essar-backend-production.up.railway.app

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_actual_cloudinary_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_actual_preset

NEXT_PUBLIC_APP_URL=http://localhost:3000
